<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <schema id="org.gnome.shell.extensions.dynamic-island" path="/org/gnome/shell/extensions/dynamic-island/">
    <key name="position" type="s">
      <choices>
        <choice value="top-center"/><choice value="top-left"/><choice value="top-right"/>
        <choice value="bottom-center"/><choice value="bottom-left"/><choice value="bottom-right"/>
        <choice value="panel-left"/><choice value="panel-center-left"/>
        <choice value="panel-center-right"/><choice value="panel-right"/>
        <choice value="panel-notch"/>
      </choices>
      <default>'top-center'</default>
      <summary>Island position on screen</summary>
    </key>
    <key name="margin" type="i">
      <range min="0" max="300"/>
      <default>6</default>
      <summary>Distance from the screen edge (px)</summary>
    </key>
    <key name="width" type="i">
      <range min="-10" max="800"/>
      <default>0</default>
      <summary>Minimum island width (px), 0 sizes it to the content, below 0 tightens the resting island</summary>
    </key>
    <key name="art-size" type="i">
      <range min="16" max="40"/>
      <default>26</default>
      <summary>Cover art size in the resting island (px)</summary>
    </key>
    <key name="art-size-expanded" type="i">
      <range min="32" max="120"/>
      <default>56</default>
      <summary>Cover art size in the expanded island (px)</summary>
    </key>
    <key name="art-shape" type="s">
      <choices>
        <choice value="auto"/><choice value="circle"/><choice value="rounded"/><choice value="square"/>
      </choices>
      <default>'auto'</default>
      <summary>Cover art shape, auto is round when resting and rounded square when expanded</summary>
    </key>
    <key name="art-border" type="s">
      <choices>
        <choice value="none"/><choice value="subtle"/><choice value="white"/><choice value="accent"/>
      </choices>
      <default>'none'</default>
      <summary>Frame around the cover art</summary>
    </key>
    <key name="art-compact" type="b">
      <default>true</default>
      <summary>Show the cover art in the resting island</summary>
    </key>
    <key name="art-spin" type="b">
      <default>false</default>
      <summary>Spin the cover like a vinyl record while playing</summary>
    </key>
    <key name="text-width" type="i">
      <range min="40" max="600"/>
      <default>230</default>
      <summary>Maximum width of the title text (px), longer titles are ellipsized</summary>
    </key>
    <key name="expand-on" type="s">
      <choices>
        <choice value="hover"/><choice value="click"/><choice value="both"/>
      </choices>
      <default>'hover'</default>
      <summary>What opens the details view</summary>
    </key>
    <key name="eq-style" type="s">
      <choices>
        <choice value="bars"/><choice value="spectrum"/><choice value="segments"/>
        <choice value="solid"/><choice value="wave"/><choice value="ribbon"/>
      </choices>
      <default>'bars'</default>
      <summary>Shape of the music visualizer</summary>
    </key>
    <key name="accent-color" type="s">
      <default>'#ff6a00'</default>
      <summary>Visualizer color (#rrggbb)</summary>
    </key>
    <key name="show-volume" type="b">
      <default>true</default>
      <summary>Show volume and brightness changes (replaces GNOME pop-up)</summary>
    </key>
    <key name="show-battery" type="b">
      <default>true</default>
      <summary>Show charger plugged/unplugged</summary>
    </key>
    <key name="show-recording" type="b">
      <default>true</default>
      <summary>Show screen recording timer</summary>
    </key>
    <key name="show-bluetooth" type="b">
      <default>true</default>
      <summary>Show Bluetooth devices connecting</summary>
    </key>
    <key name="show-progress" type="b">
      <default>true</default>
      <summary>Show download and file copy progress</summary>
    </key>
  </schema>
</schemalist>
